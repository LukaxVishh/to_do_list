# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Responsável: Dev 1 (Infraestrutura e Ambiente)
# Instruções: Copie este arquivo para um arquivo chamado '.env' no mesmo diretório
# e preencha com os valores específicos para o seu ambiente de desenvolvimento.
# ==============================================================================

# Chave secreta de segurança do Django (nunca compartilhe ou versione em produção)
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-aqui

# Modo de depuração (True para desenvolvimento local, False para produção)
DEBUG=True

# Hosts autorizados a acessar a aplicação (valores separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost
