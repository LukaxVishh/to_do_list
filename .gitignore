# ==============================================================================
# ARQUIVO DE IGNORAÇÃO DO GIT (.gitignore)
# Projeto: API RESTful de Gestão de Projetos e Tarefas (Django + DRF)
# ==============================================================================

# Arquivos de bytecode compilados do Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais (NÃO versionar)
.venv/
venv/
ENV/
env/
.env.local

# Arquivos de variáveis de ambiente com dados sensíveis
.env
*.env

# Banco de dados local SQLite (NÃO versionar conforme requisitos)
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Logs e relatórios de execução
*.log
pip-log.txt
pip-delete-this-directory.txt

# Relatórios de testes e cobertura de código
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# Configurações de IDEs e editores de código
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Distribuição e empacotamento
build/
dist/
*.egg-info/
*.egg
